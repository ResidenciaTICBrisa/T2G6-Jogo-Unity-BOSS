# EditorConfig for Unity C# Project
# https://editorconfig.org/

root = true

# All files
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# C# files
[*.cs]
indent_style = space
indent_size = 4
max_line_length = 120

# Code style rules
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Naming conventions for Unity
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = warning
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interface
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = prefix_interface_with_i

dotnet_naming_rule.public_members_should_be_capitalized.severity = warning
dotnet_naming_rule.public_members_should_be_capitalized.symbols = public_symbols
dotnet_naming_rule.public_members_should_be_capitalized.style = pascal_case

# Symbol specifications
dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_symbols.public_symbols.applicable_kinds = property,method,field,event,delegate
dotnet_naming_symbols.public_symbols.applicable_accessibilities = public

# Naming styles
dotnet_naming_style.prefix_interface_with_i.required_prefix = I
dotnet_naming_style.prefix_interface_with_i.capitalization = pascal_case

dotnet_naming_style.pascal_case.capitalization = pascal_case

# Unity specific rules (disable some IDE suggestions that don't apply to Unity)
dotnet_diagnostic.IDE0051.severity = none  # Remove unused private members (Unity MonoBehaviour methods)
dotnet_diagnostic.IDE0052.severity = none  # Remove unread private members (Unity SerializeField)
dotnet_diagnostic.CS0649.severity = none   # Field never assigned (Unity Inspector assigns values)

# Code quality rules
dotnet_analyzer_diagnostic.CA1001.severity = warning  # Types that own disposable fields should be disposable
dotnet_analyzer_diagnostic.CA1031.severity = suggestion  # Do not catch general exception types
dotnet_analyzer_diagnostic.CA1816.severity = warning  # Dispose methods should call SuppressFinalize

# Formatting rules
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
